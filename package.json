{
  "name": "delbicos",
  "version": "6.16.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "test": "jest",
    "web": "expo start --web",
    "set:dev": "cp environments/.env.dev .env && echo 'Switched to DEV environment'",
    "set:prod": "cp environments/.env.prod .env && echo 'Switched to PROD environment'",
    "android": "npm run android:stable",
    "android:expo": "expo run:android",
    "android:stable": "npm run android:install && npm run start",
    "android:assemble:debug": "node scripts/android/gradlew-runner.mjs app:assembleDebug -x lint -x test --build-cache -PreactNativeDevServerPort=8081",
    "android:assemble:release": "node scripts/android/gradlew-runner.mjs app:assembleRelease -x lint -x test --build-cache -PreactNativeDevServerPort=8081",
    "android:deploy:debug": "npm run set:dev && npm run android:assemble:debug && npm run cp:android:debug",
    "android:deploy:release": "npm run set:prod && npm run android:assemble:release && npm run cp:android:release",
    "cp:android:debug": "mkdir -p releases && cp android/app/build/outputs/apk/debug/app-debug.apk ./releases/delbicos-debug-$(date +%Y%m%d%H%M).apk && echo 'Debug APK copied to releases folder'",
    "cp:android:release": "mkdir -p releases && cp android/app/build/outputs/apk/release/app-release.apk ./releases/delbicos-release-$(date +%Y%m%d%H%M).apk && echo 'Release APK copied to releases folder'",
    "cp:android:bundle": "mkdir -p releases && cp android/app/build/outputs/bundle/release/app-release.aab ./releases/delbicos-android-$(date +%Y%m%d%H%M).aab && echo 'AAB copied to releases folder'",
    "android:install": "node scripts/android/gradlew-runner.mjs app:installDebug -x lint -x test --build-cache -PreactNativeDevServerPort=8081",
    "android:clean": "node scripts/android/clean.mjs",
    "android:clean:cache": "expo run:android --no-build-cache",
    "android:no-bundler": "expo run:android --no-bundler",
    "android:release": "expo run:android --variant release",
    "android:jvm": "node scripts/android/jvm-info.mjs",
    "ios": "expo run:ios",
    "ios:clean": "expo run:ios --no-build-cache",
    "ios:no-bundler": "expo run:ios --no-bundler",
    "ios:release": "expo run:ios --configuration Release",
    "lint": "expo lint",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:start": "docker-compose exec delbicos-frontend npm run start",
    "docker:exec": "docker-compose exec delbicos-frontend sh",
    "docker:down": "docker-compose down",
    "docker:stop": "docker-compose stop",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "docker:rebuild": "docker-compose down && docker-compose build --no-cache && docker-compose up",
    "docker:copy:env": "docker cp .env webapp-delbicos:/app/.env",
    "docker:network": "docker network create delbicos-shared-network"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-google-maps/api": "^2.20.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.1.1",
    "@react-navigation/elements": "^2.2.3",
    "@react-navigation/native": "^7.0.12",
    "@react-navigation/native-stack": "^7.1.13",
    "@stripe/react-stripe-js": "^5.2.0",
    "@stripe/stripe-js": "^8.1.0",
    "@stripe/stripe-react-native": "0.50.3",
    "axios": "^1.9.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.9",
    "expo-audio": "~1.1.1",
    "expo-dev-client": "~6.0.15",
    "expo-file-system": "^19.0.17",
    "expo-font": "~14.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-location": "^19.0.7",
    "expo-notifications": "^0.32.12",
    "expo-print": "15.0.8",
    "expo-sharing": "^14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-system-ui": "~6.0.7",
    "expo-zustand-persist": "^1.0.4",
    "papaparse": "^5.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.63.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-maps": "1.20.1",
    "react-native-popup-menu": "^0.18.0",
    "react-native-ratings": "^8.1.0",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "^0.21.1",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/compat": "^1.2.9",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.27.0",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.5.0",
    "@types/react": "~19.1.17",
    "@types/react-native-calendars": "^1.1264.7",
    "@types/react-native-maps": "^0.24.1",
    "eslint": "^9.27.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "jest-expo": "~54.0.18",
    "prettier": "^3.5.3",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "^5.7.2"
  }
}
